        "--host",
        "127.0.0.1"
      ],
      "port": 5173
    },
    {
      "name": "web-ds002",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@qubite/web",
        "exec",
        "vite",
        "--port",
        "5182",
        "--strictPort",
        "--host",
        "127.0.0.1"
      ],
