            "type": "string",
            "const": "qubite-core",
            "title": "Service",
            "default": "qubite-core"
          },
          "api_version": {
            "type": "string",
            "const": "v1",
            "title": "Api Version",
            "default": "v1"
          },
          "status": {
            "type": "string",
