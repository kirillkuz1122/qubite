{
  "contract_version": "auth-v1",
  "task": "QUB-AUTH-005",
  "scope": "verified account-login boundary; subset of identity-v2, not a new identity authority",
  "identity_contract": "identity-v2.json",
  "openapi_contract": "core-v1.json",
  "authority": "FastAPI/PostgreSQL fresh UUID identity",
  "account_code_entry": false,
  "legacy_import": false,
  "password_login": {
    "method": "POST",
    "path": "/api/v1/auth/session",
    "required_fields": ["email", "password"],
    "allowed_fields": ["email", "password"],
    "additional_properties": false,
    "csrf_bootstrap": "/api/v1/auth/csrf",
    "credential": "HttpOnly session cookie; no raw session token in response",
    "invalid_dto": {"status": 400, "code": "invalid_request"},
    "wrong_password": {"status": 401, "code": "invalid_credentials"},
    "grants_modules": false,
    "grants_models": false,
    "grants_owner": false,
    "legacy_alias": false
  },
  "rejected_routes": [
    "/api/auth/code-entry",
    "/api/auth/code-entry/inspect",
    "/api/auth/login",
    "/api/v1/auth/code-entry",
    "/api/v1/auth/code-entry/inspect",
    "/api/v1/auth/login"
  ],
  "rejection": {
    "methods": ["GET", "POST"],
    "status": 404,
    "authenticated_or_anonymous": "same not-found result; no replacement session or redirect",
    "reverse_proxy_requirement": "new product auth namespace routes exclusively to core; no Node fallback",
    "ingress_status": "planned, not configured by AUTH-005"
  },
  "separate_protocols": {
    "tournament_join": {
      "authority": "optional legacy module, currently Node/SQLite",
      "path": "/api/tournaments/{id}/join",
      "credential": "existing authenticated participant session and verified email",
      "fields": ["accessCode"],
      "modes": ["shared", "personal"],
      "grants_platform_session": false,
      "core_adapter_status": "planned"
    },
    "email_verify": {
      "request": "/api/v1/auth/email/verify/request",
      "confirm": "/api/v1/auth/email/verify/confirm",
      "token_prefix": "qbt_ev_",
      "grants_session": false
    },
    "email_reset": {
      "request": "/api/v1/auth/email/reset/request",
      "confirm": "/api/v1/auth/email/reset/confirm",
      "token_prefix": "qbt_er_",
      "grants_session": false
    },
    "oauth": {
      "callback": "/api/v1/auth/oauth/{provider}/callback",
      "code_is": "one-use provider exchange bound to state, PKCE and configured provider identity",
      "account_code_entry": false,
      "default": "disabled, external network off"
    },
    "native_pkce": {"status": "planned", "task": "QUB-AUTH-012"},
    "email_two_factor": {"status": "protocol_only", "task": "QUB-AUTH-011"},
    "registration_invitation": {"status": "planned", "task": "QUB-AUTH-006"}
  },
  "runtime_changes": false,
  "production_deployment": false
}
