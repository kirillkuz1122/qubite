  "routes": [
    {
      "method": "GET",
      "path": "/api/v1/me/access"
    },
    {
      "method": "GET",
      "path": "/api/v1/owner/policy"
    },
    {
      "method": "POST",
      "path": "/api/v1/policy/check"
    },
    {
      "method": "POST",
      "path": "/api/v1/owner/policy/commands"
