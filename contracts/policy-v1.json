      "resource_id": {
        "format": "uuid",
        "title": "Resource Id",
        "type": "string"
      },
      "provider": {
        "anyOf": [
          {
            "pattern": "^[a-z][a-z0-9_-]{0,47}$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Provider"
