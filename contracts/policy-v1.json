{
  "version": "1.1",
  "task": "QUB-AUTH-003",
  "status": "implemented",
  "core_version": "0.7.0",
  "migration": "0008_catalog",
  "default": "deny",
  "actions": [
    "read",
    "write",
    "manage",
    "ai"
