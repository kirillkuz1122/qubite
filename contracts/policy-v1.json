    "token_type": "qbt_d_",
    "max_ttl_seconds": 300,
    "max_active_per_session": 32,
    "target_count": 1,
    "session_bound": true,
    "auth_version_bound": true,
    "policy_revision_bound": true
  },
  "target_schema": {
    "additionalProperties": false,
    "properties": {
      "module": {
        "pattern": "^[a-z][a-z0-9_]{0,31}$",
        "title": "Module",
        "type": "string"
      },
      "action": {
        "enum": [
          "read",
          "write",
          "manage",
          "ai"
