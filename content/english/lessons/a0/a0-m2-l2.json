  "grammar": {
    "title_ru": "a / an; this is; What's this? — It's a…",
    "explain_ru": "В английском перед одной вещью ставят маленькое слово a: a phone, a book. Если слово начинается с гласного звука — an: an apple, an egg. По-русски этого слова нет, поэтому его все забывают! «Это …» — This is a … или It's a …. Спросить: What's this?",
    "explain_en": "One thing: a phone, a book, an apple. What's this? — It's a pen.",
    "examples": [
      { "en": "What's this? — It's a charger.", "ru": "Что это? — Это зарядка." },
      { "en": "This is my laptop.", "ru": "Это мой ноутбук." },
      { "en": "It's an apple.", "ru": "Это яблоко." }
    ],
    "mistakes": [
      { "wrong": "It's phone.", "right": "It's a phone.", "why_ru": "Перед одной вещью нужен a." },
      { "wrong": "a apple", "right": "an apple", "why_ru": "Перед гласным звуком — an." },
      {
        "wrong": "This is a my phone.",
        "right": "This is my phone.",
        "why_ru": "Есть my — a не нужен."
      },
      { "wrong": "notebook (о ноутбуке)", "right": "laptop", "why_ru": "notebook — тетрадь." }
    ],
    "tutor_notes_ru": "a/an — первая встреча с артиклем, главная ловушка для русских. Не объяснять the. Ловить «It's phone» каждый раз, но мягко. Правило «a нет, если есть my»."
  },
  "phrases": [
    { "en": "What's this?", "ru": "Что это?" },
    { "en": "It's a …", "ru": "Это …" },
    { "en": "This is my …", "ru": "Это мой …" },
    { "en": "Where's my charger?!", "ru": "Где моя зарядка?!" }
  ],
  "talk": {
