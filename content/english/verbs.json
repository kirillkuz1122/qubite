{
  "version": 1,
  "groups": [
    {
      "id": "same",
      "title_ru": "Все три одинаковые",
      "hint": "cut – cut – cut: ничего не меняется"
    },
    { "id": "i-a-u", "title_ru": "i → a → u", "hint": "sing – sang – sung" },
    { "id": "i-u-u", "title_ru": "i → u → u", "hint": "win – won – won, stick – stuck – stuck" },
    {
      "id": "ought",
      "title_ru": "-ought / -aught",
      "hint": "buy – bought – bought, catch – caught – caught"
    },
    { "id": "o-en", "title_ru": "o → o + en", "hint": "break – broke – broken" },
    { "id": "ore-orn", "title_ru": "-ear → -ore → -orn", "hint": "wear – wore – worn" },
    { "id": "i-o-en", "title_ru": "i → o → i + en", "hint": "drive – drove – driven" },
    { "id": "ew-own", "title_ru": "-ew → -own", "hint": "know – knew – known" },
    { "id": "ake-ook", "title_ru": "-ake → -ook → -aken", "hint": "take – took – taken" },
    {
      "id": "ee-e-t",
      "title_ru": "Долгий звук → короткий + t",
      "hint": "keep – kept – kept, feel – felt – felt"
    },
    { "id": "d-t", "title_ru": "-d → -t", "hint": "send – sent – sent" },
    {
      "id": "long-short",
      "title_ru": "Гласная становится короткой",
      "hint": "feed – fed – fed, lose – lost – lost"
    },
    {
      "id": "d",
      "title_ru": "Вторая и третья на -d",
      "hint": "say – said – said, sell – sold – sold"
    },
    { "id": "ound", "title_ru": "-ind → -ound", "hint": "find – found – found" },
    {
      "id": "v2v3",
      "title_ru": "Вторая = третья, остальные",
      "hint": "sit – sat – sat, stand – stood – stood"
    },
    { "id": "en", "title_ru": "Третья на -en", "hint": "give – gave – given, eat – ate – eaten" },
    {
      "id": "special",
      "title_ru": "Особенные — просто запомнить",
      "hint": "be – was/were – been, go – went – gone"
    },
    { "id": "come", "title_ru": "Первая = третья", "hint": "come – came – come, run – ran – run" },
    {
      "id": "t-ed",
      "title_ru": "Можно на -t, можно на -ed",
      "hint": "learn – learnt – learnt (или learned)"
    },
    {
      "id": "prefix",
      "title_ru": "С приставкой — как основной глагол",
      "hint": "undo – undid – undone (как do)"
    }
  ],
