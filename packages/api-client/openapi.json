{
  "openapi": "3.1.0",
  "info": {
    "title": "Qubite API",
    "description": "API ядра Qubite 2.0",
    "license": {
      "name": "UNLICENSED",
      "identifier": "UNLICENSED"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/api/auth/device/authorize": {
      "post": {
        "tags": ["auth"],
        "summary": "Разрешить приложению вход (из браузера, где человек уже вошёл). Возвращает\nадрес возврата в приложение с одноразовым кодом на 5 минут.",
        "operationId": "device_authorize",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeviceAuthorizeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Вход разрешён",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceAuthorizeResponse"
                }
              }
            }
          },
          "400": {
            "description": "Неверный запрос (например, не S256)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "Не выполнен вход в браузере или неизвестное приложение",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "Нет или неверный CSRF-токен",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/device/token": {
      "post": {
        "tags": ["auth"],
        "summary": "Получить или обновить токены устройства (OAuth 2.0, PKCE).",
        "operationId": "device_token",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeviceTokenRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Токены устройства",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceTokenResponse"
                }
              }
            }
          },
          "400": {
            "description": "`invalid_grant` — код или refresh-токен недействителен",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "`invalid_client` — неизвестное приложение",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": ["auth"],
        "summary": "Войти по почте и паролю.",
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Вход выполнен; ставятся cookie `qubite_session` и `qubite_csrf`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "401": {
            "description": "Неверная почта или пароль",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "Аккаунт заблокирован или почта не подтверждена",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          },
          "429": {
            "description": "Слишком много попыток; заголовок `Retry-After` — через сколько секунд",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": ["auth"],
        "summary": "Выйти: закрыть текущую сессию.",
        "operationId": "logout",
        "responses": {
          "204": {
            "description": "Сессия закрыта, cookie стёрты"
          },
          "401": {
            "description": "Не выполнен вход",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "Нет или неверный CSRF-токен",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/logout-everywhere": {
      "post": {
        "tags": ["auth"],
        "summary": "«Выйти везде»: закрыть все сессии аккаунта, включая текущую.",
        "operationId": "logout_everywhere",
        "responses": {
          "200": {
            "description": "Все сессии закрыты, cookie стёрты",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RevokedCount"
                }
              }
            }
          },
          "401": {
            "description": "Не выполнен вход",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "Нет или неверный CSRF-токен",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "tags": ["auth"],
        "summary": "Кто вошёл.",
        "operationId": "whoami",
        "responses": {
          "200": {
            "description": "Текущий аккаунт и сессия",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "401": {
            "description": "Не выполнен вход",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/sessions": {
      "get": {
        "tags": ["auth"],
        "summary": "Мои открытые сессии, свежие сверху.",
        "operationId": "list_sessions",
        "responses": {
          "200": {
            "description": "Открытые сессии аккаунта",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SessionItem"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Не выполнен вход",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/sessions/{id}": {
      "delete": {
        "tags": ["auth"],
        "summary": "Закрыть одну свою сессию (например, на потерянном устройстве).",
        "operationId": "revoke_session",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "ID сессии",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Сессия закрыта"
          },
          "401": {
            "description": "Не выполнен вход",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "Нет или неверный CSRF-токен",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "Нет такой открытой сессии у этого аккаунта",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "tags": ["system"],
        "summary": "Жив ли процесс сервера. Не обращается к базе.",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Сервер отвечает",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/modules": {
      "get": {
        "tags": ["modules"],
        "summary": "Каталог модулей для текущего пользователя. Скрытые модули без доступа не показываются.",
        "operationId": "my_catalog",
        "responses": {
          "200": {
            "description": "Модули с состоянием для этого пользователя",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CatalogItem"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Не выполнен вход",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/modules/{id}": {
      "get": {
        "tags": ["modules"],
        "summary": "Один модуль глазами текущего пользователя.",
        "operationId": "my_module",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "ID модуля, например `docs`",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Состояние модуля и права пользователя",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogItem"
                }
              }
            }
          },
          "401": {
            "description": "Не выполнен вход",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "Нет такого модуля или он скрыт",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/owner/accounts/{account_id}/grants": {
      "get": {
        "tags": ["owner"],
        "summary": "Owner Console: гранты пользователя.",
        "operationId": "owner_grants",
        "parameters": [
          {
            "name": "account_id",
            "in": "path",
            "description": "ID аккаунта",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Живые гранты",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/GrantItem"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Не owner",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/owner/accounts/{account_id}/grants/{module_id}": {
      "put": {
        "tags": ["owner"],
        "summary": "Owner Console: выдать или изменить права пользователя в модуле.",
        "operationId": "owner_set_grant",
        "parameters": [
          {
            "name": "account_id",
            "in": "path",
            "description": "ID аккаунта",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "module_id",
            "in": "path",
            "description": "ID модуля",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GrantChange"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Грант выдан",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GrantItem"
                }
              }
            }
          },
          "204": {
            "description": "Все права сняты — грант отозван"
          },
          "404": {
            "description": "Нет аккаунта, модуля или не owner",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["owner"],
        "summary": "Owner Console: отозвать права пользователя в модуле. Действует сразу.",
        "operationId": "owner_revoke_grant",
        "parameters": [
          {
            "name": "account_id",
            "in": "path",
            "description": "ID аккаунта",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "module_id",
            "in": "path",
            "description": "ID модуля",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Грант отозван"
          },
          "404": {
            "description": "Гранта не было или не owner",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/owner/modules": {
      "get": {
        "tags": ["owner"],
        "summary": "Owner Console: все модули.",
        "operationId": "owner_modules",
        "responses": {
          "200": {
            "description": "Весь каталог",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ModuleItem"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Не owner (раздел для остальных не существует)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/owner/modules/{id}": {
      "patch": {
        "tags": ["owner"],
        "summary": "Owner Console: установить, включить, выключить модуль, сменить готовность и видимость.",
        "operationId": "owner_update_module",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "ID модуля",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ModuleChange"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Модуль изменён",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModuleItem"
                }
              }
            }
          },
          "400": {
            "description": "Неверное значение или модуль уже изменён",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "Нет модуля или не owner",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/ready": {
      "get": {
        "tags": ["system"],
        "summary": "Готов ли сервер обслуживать запросы: отвечает ли база и применены ли миграции.",
        "operationId": "ready",
        "responses": {
          "200": {
            "description": "Готов",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          },
          "503": {
            "description": "База недоступна или схема не создана",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiErrorBody": {
        "type": "object",
        "description": "Ответ с ошибкой: машиночитаемый код и понятный человеку текст.",
        "required": ["error", "message"],
        "properties": {
          "error": {
            "type": "string",
            "description": "Код ошибки, например `invalid_credentials`."
          },
          "message": {
            "type": "string",
            "description": "Текст для человека."
          }
        }
      },
      "CatalogItem": {
        "type": "object",
        "description": "Модуль в каталоге пользователя.",
        "required": ["id", "title", "status", "flags"],
        "properties": {
          "flags": {
            "$ref": "#/components/schemas/ModuleFlags",
            "description": "Права пользователя; все `false`, если модуль недоступен."
          },
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "description": "`available` — можно пользоваться; `locked` — замок, доступ выдаёт owner;\n`preparing` — «Готовится»; `unavailable` — «Временно недоступен».",
            "example": "locked"
          },
          "title": {
            "type": "string"
          }
        }
      },
      "DeviceAuthorizeRequest": {
        "type": "object",
        "required": [
          "client_id",
          "redirect_uri",
          "code_challenge",
          "code_challenge_method",
          "state"
        ],
        "properties": {
          "client_id": {
            "type": "string",
            "description": "`qubite-desktop` или `qubite-android`."
          },
          "code_challenge": {
            "type": "string",
            "description": "`BASE64URL(SHA256(code_verifier))`, 43 символа."
          },
          "code_challenge_method": {
            "type": "string",
            "description": "Только `S256`."
          },
          "device_name": {
            "type": "string",
            "description": "Как назвать устройство в списке сессий."
          },
          "redirect_uri": {
            "type": "string",
            "description": "`qubite://auth/callback` (desktop — ещё `http://127.0.0.1:<порт>/callback`)."
          },
          "state": {
            "type": "string",
            "description": "Случайная строка приложения; вернётся в адресе без изменений."
          }
        }
      },
      "DeviceAuthorizeResponse": {
        "type": "object",
        "required": ["redirect_to"],
        "properties": {
          "redirect_to": {
            "type": "string",
            "description": "Куда отправить браузер: адрес приложения с `code` и `state`."
          }
        }
      },
      "DeviceTokenRequest": {
        "type": "object",
        "description": "Тело запроса токенов. `grant_type`: `authorization_code` (нужны `code`,\n`code_verifier`, `redirect_uri`) или `refresh_token` (нужен `refresh_token`).",
        "required": ["grant_type", "client_id"],
        "properties": {
          "client_id": {
            "type": "string"
          },
          "code": {
            "type": ["string", "null"]
          },
          "code_verifier": {
            "type": ["string", "null"]
          },
          "grant_type": {
            "type": "string"
          },
          "redirect_uri": {
            "type": ["string", "null"]
          },
          "refresh_token": {
            "type": ["string", "null"]
          }
        }
      },
      "DeviceTokenResponse": {
        "type": "object",
        "required": ["token_type", "access_token", "expires_in", "refresh_token", "session_id"],
        "properties": {
          "access_token": {
            "type": "string",
            "description": "Для заголовка `Authorization: Bearer …`; живёт `expires_in` секунд."
          },
          "expires_in": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "refresh_token": {
            "type": "string",
            "description": "Одноразовый: при обновлении выдаётся новый. Хранить в защищённом хранилище ОС."
          },
          "session_id": {
            "type": "string",
            "format": "uuid",
            "description": "ID сессии устройства (видна в списке сессий)."
          },
          "token_type": {
            "type": "string",
            "description": "Всегда `Bearer`."
          }
        }
      },
      "GrantChange": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ModuleFlags"
          },
          {
            "type": "object",
            "properties": {
              "reason": {
                "type": ["string", "null"],
                "description": "Зачем (попадёт в журнал)."
              }
            }
          }
        ],
        "description": "Какие права выдать. Все `false` — то же, что отзыв."
      },
      "GrantItem": {
        "type": "object",
        "description": "Грант пользователя в модуле.",
        "required": ["module_id", "flags", "granted_at", "version"],
        "properties": {
          "flags": {
            "$ref": "#/components/schemas/ModuleFlags"
          },
          "granted_at": {
            "type": "string",
            "format": "date-time"
          },
          "granted_by": {
            "type": ["string", "null"],
            "format": "uuid"
          },
          "module_id": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "Health": {
        "type": "object",
        "required": ["status", "version"],
        "properties": {
          "status": {
            "type": "string",
            "description": "Всегда `ok`, если процесс отвечает."
          },
          "version": {
            "type": "string",
            "description": "Версия Qubite."
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": {
            "type": "string",
            "description": "Почта аккаунта; регистр не важен."
          },
          "password": {
            "type": "string",
            "description": "Пароль. Не логируется и не сохраняется."
          }
        }
      },
      "LoginResponse": {
        "type": "object",
        "required": ["account", "csrf_token"],
        "properties": {
          "account": {
            "$ref": "#/components/schemas/Me"
          },
          "csrf_token": {
            "type": "string",
            "description": "CSRF-токен; то же значение лежит в cookie `qubite_csrf`."
          }
        }
      },
      "Me": {
        "type": "object",
        "description": "Кто вошёл.",
        "required": ["id", "email", "display_name", "is_owner", "session_id", "session_expires_at"],
        "properties": {
          "display_name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "is_owner": {
            "type": "boolean",
            "description": "Owner платформы (видит Owner Console)."
          },
          "session_expires_at": {
            "type": "string",
            "format": "date-time",
            "description": "Когда сессия истечёт, если ей не пользоваться."
          },
          "session_id": {
            "type": "string",
            "format": "uuid",
            "description": "ID текущей сессии."
          }
        }
      },
      "ModuleChange": {
        "type": "object",
        "description": "Что поменять в модуле. Пустые поля не меняются.",
        "properties": {
          "expected_version": {
            "type": ["integer", "null"],
            "format": "int64",
            "description": "Версия, которую видел owner; если модуль уже изменили — 400."
          },
          "installed": {
            "type": ["boolean", "null"]
          },
          "readiness": {
            "type": ["string", "null"]
          },
          "state": {
            "type": ["string", "null"]
          },
          "visibility": {
            "type": ["string", "null"]
          }
        }
      },
      "ModuleFlags": {
        "type": "object",
        "description": "Права в модуле.",
        "required": ["read", "write", "manage", "ai"],
        "properties": {
          "ai": {
            "type": "boolean"
          },
          "manage": {
            "type": "boolean"
          },
          "read": {
            "type": "boolean"
          },
          "write": {
            "type": "boolean"
          }
        }
      },
      "ModuleItem": {
        "type": "object",
        "description": "Модуль глазами owner.",
        "required": [
          "id",
          "title",
          "installed",
          "state",
          "readiness",
          "visibility",
          "version",
          "updated_at"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "installed": {
            "type": "boolean"
          },
          "readiness": {
            "type": "string",
            "description": "`planned`, `beta` или `stable`."
          },
          "state": {
            "type": "string",
            "description": "`enabled`, `disabled` или `maintenance`."
          },
          "title": {
            "type": "string"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "version": {
            "type": "integer",
            "format": "int64"
          },
          "visibility": {
            "type": "string",
            "description": "`locked` или `hidden` — как модуль виден без доступа."
          }
        }
      },
      "Readiness": {
        "type": "object",
        "required": ["status", "database"],
        "properties": {
          "database": {
            "type": "string",
            "description": "`ok` или `unavailable`."
          },
          "schema_version": {
            "type": ["integer", "null"],
            "format": "int64",
            "description": "Номер последней применённой миграции."
          },
          "status": {
            "type": "string",
            "description": "`ready` или `not_ready`."
          }
        }
      },
      "RevokedCount": {
        "type": "object",
        "required": ["revoked"],
        "properties": {
          "revoked": {
            "type": "integer",
            "format": "int64",
            "description": "Сколько сессий закрыто.",
            "minimum": 0
          }
        }
      },
      "SessionItem": {
        "type": "object",
        "description": "Сессия в списке «Мои сессии».",
        "required": [
          "id",
          "kind",
          "device_name",
          "user_agent",
          "ip",
          "created_at",
          "last_seen_at",
          "expires_at",
          "current"
        ],
        "properties": {
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "current": {
            "type": "boolean",
            "description": "Это сессия, с которой сделан запрос."
          },
          "device_name": {
            "type": "string",
            "description": "Имя устройства (для приложений)."
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "ip": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "description": "`web` или `device`."
          },
          "last_seen_at": {
            "type": "string",
            "format": "date-time"
          },
          "user_agent": {
            "type": "string"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "system",
      "description": "Состояние сервера"
    },
    {
      "name": "auth",
      "description": "Вход, выход и сессии. Изменяющие запросы с сессией-cookie требуют заголовок `X-CSRF-Token`; приложения вместо cookie шлют `Authorization: Bearer <access_token>`."
    },
    {
      "name": "modules",
      "description": "Каталог модулей и права пользователя"
    },
    {
      "name": "owner",
      "description": "Owner Console. Для всех, кроме owner, этих адресов нет (404)"
    }
  ]
}
