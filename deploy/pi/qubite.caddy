# Caddy для нового Qubite на Pi (OPS-005). Подключается из /etc/caddy/Caddyfile строкой
#   import /etc/caddy/qubite.caddy
# Cloudflare Tunnel ведёт qubiteapp.online и auth.qubiteapp.online на этот порт.
# Слушает только 127.0.0.1: заголовок CF-Connecting-IP приходит лишь от туннеля.
# Сайт — одно приложение на всех хостах, /api/* — на `qubite serve` (ADR-0006).
http://:9284 {
	bind 127.0.0.1
	@wrongHost not host qubiteapp.online auth.qubiteapp.online
	respond @wrongHost "Unknown host" 404

	# SEC-002 (D-770, D-771). Единственный источник CSP: его же читает
	# apps/web/playwright.csp.config.ts, так что проверка в браузере идёт с этой строкой.
	# Cloudflare сам закрывает TLS, поэтому HSTS ставим здесь: заголовок дойдёт до браузера.
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self' https://challenges.cloudflare.com https://smartcaptcha.yandexcloud.net https://telegram.org; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; media-src 'self' blob:; connect-src 'self' wss://qubiteapp.online wss://auth.qubiteapp.online https://challenges.cloudflare.com https://smartcaptcha.yandexcloud.net; frame-src https://challenges.cloudflare.com https://smartcaptcha.yandexcloud.net https://oauth.telegram.org; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'"
		Strict-Transport-Security "max-age=31536000"
	}

	handle /api/* {
		reverse_proxy 127.0.0.1:9300 {
			header_up X-Forwarded-Proto https
			# Сервер берёт последний адрес из X-Forwarded-For. За туннелем это был бы
			# cloudflared (127.0.0.1) — подставляем настоящий адрес из Cloudflare.
			header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
		}
	}
	handle {
		root * /opt/qubite/current/web
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		header ?Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
