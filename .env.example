# Qubite 2.0 — пример конфигурации.
# Скопируйте в .env (для разработки) или /etc/qubite/qubite.env (сервер, права 600) и заполните.
# .env в корне проекта читает сам `qubite` (D-282); переменные окружения сильнее файла.
# Значения ниже — для разработки на своём компьютере; для сервера — в комментариях «сервер:».
# Набор переменных — целевой; он уточняется в задачах FND-001, AUTH-*, AI-*, OPS-001.
# Ключ OpenRouter пока задаётся здесь (права файла 600); позже — в Owner Console зашифрованно (ACC-004).

# --- Сервер ---
QUBITE_ENV=dev                         # dev | prod
QUBITE_BIND=127.0.0.1:8080
QUBITE_LOG=info
QUBITE_DATA_DIR=./data                 # файлы (blobs), локальные данные

# --- Домены ---
QUBITE_DOMAIN=qubiteapp.ru             # основной домен; модули — поддомены (auth., plan., docs., …)
QUBITE_PUBLIC_URL=http://localhost:5173   # сервер: https://qubiteapp.ru
QUBITE_AUTH_URL=http://localhost:5173     # сервер: https://auth.qubiteapp.ru
QUBITE_TRUST_PROXY=false               # true за Caddy/Cloudflare

# --- База данных ---
# Разработка — локальная база из `just db-up` (D-281; тесты берут свою, :55433).
# Сервер: postgres://qubite:<пароль>@127.0.0.1:5432/qubite
DATABASE_URL=postgres://qubite:qubite@127.0.0.1:55432/postgres
DATABASE_MAX_CONNECTIONS=10

# --- Шифрование секретов в БД ---
QUBITE_SECRETS_KEY=                    # 32 байта base64; сгенерировать: openssl rand -base64 32

# --- Сессии ---
# Только сервер (на localhost не задавать — иначе вход не сохранится):
# QUBITE_SESSION_COOKIE_DOMAIN=.qubiteapp.ru
QUBITE_SESSION_TTL_DAYS=30                # срок сессии, продлевается при использовании
QUBITE_COOKIE_SECURE=true                 # cookie только по HTTPS (localhost браузеры тоже пускают)

# --- Аварийные переключатели (сильнее тумблеров Owner Console, ACC-002) ---
# false — выключить; owner всё равно входит по паролю и работает при техработах.
QUBITE_MAINTENANCE=false               # true — техработы для всех, кроме owner; сильнее бота и команды
QUBITE_EMAIL_ENABLED=true              # false — письма не отправляются
QUBITE_AUTH_LOGIN_ENABLED=true
QUBITE_AUTH_REGISTRATION_ENABLED=true
QUBITE_AUTH_PASSWORD_ENABLED=true
QUBITE_AUTH_GOOGLE_ENABLED=true
QUBITE_AUTH_YANDEX_ENABLED=true
QUBITE_AUTH_VK_ENABLED=true
QUBITE_AUTH_TELEGRAM_ENABLED=true

# --- Почта (AUTH-002) ---
QUBITE_EMAIL_MODE=mock                 # mock (никуда не отправлять) | resend | smtp
QUBITE_EMAIL_FROM="Qubite <no-reply@qubiteapp.ru>"
QUBITE_EMAIL_REPLY_TO=                 # необязательно, например support@qubiteapp.ru
QUBITE_RESEND_API_KEY=                 # для resend: ключ из resend.com (домен qubiteapp.ru подтверждён там)
QUBITE_SMTP_URL=                       # для smtp: smtps://логин:пароль@smtp.yandex.ru:465 или smtp://…:587?tls=required

# --- Вход через провайдеров (AUTH-004) ---
# Адрес возврата у провайдера: $QUBITE_PUBLIC_URL/api/auth/oauth/<yandex|vk|google>/callback
# Без CLIENT_ID способ входа не показывается. *_ENABLED — стартовое положение (D-194).
QUBITE_OAUTH_YANDEX_CLIENT_ID=
QUBITE_OAUTH_YANDEX_CLIENT_SECRET=
QUBITE_OAUTH_YANDEX_ENABLED=true
QUBITE_OAUTH_VK_CLIENT_ID=
QUBITE_OAUTH_VK_CLIENT_SECRET=
QUBITE_OAUTH_VK_ENABLED=true
QUBITE_OAUTH_GOOGLE_CLIENT_ID=
QUBITE_OAUTH_GOOGLE_CLIENT_SECRET=
QUBITE_OAUTH_GOOGLE_ENABLED=false
QUBITE_TELEGRAM_LOGIN_ENABLED=false       # вход через виджет Telegram (бот — ниже)
QUBITE_TELEGRAM_BOT_NAME=                 # имя нового бота без @

# --- CAPTCHA (AUTH-003): какую показывать — выбирает owner, ключи — здесь ---
QUBITE_CAPTCHA_DISABLED=false          # true — выключить CAPTCHA совсем (сильнее выбора owner)
QUBITE_TURNSTILE_SITE_KEY=
QUBITE_TURNSTILE_SECRET_KEY=
QUBITE_SMARTCAPTCHA_SITE_KEY=          # Yandex SmartCaptcha: ключ клиента
QUBITE_SMARTCAPTCHA_SECRET_KEY=        # Yandex SmartCaptcha: ключ сервера

# --- Входящие ---
QUBITE_INBOX_TRASH_DAYS=30                # корзина удаляется навсегда через N дней; 0 — никогда

# --- Telegram-бот (CMD-006): новый бот, не старый с Pi ---
# 1) @BotFather → /newbot → токен сюда; 2) имя бота (без @) — в QUBITE_TELEGRAM_BOT_NAME выше;
# 3) запустить `qubite bot`; 4) в профиле Qubite «Привязать Telegram» (ссылка на бота с кодом).
QUBITE_TELEGRAM_BOT_TOKEN=                # токен от @BotFather; вставляет владелец
QUBITE_TELEGRAM_API=https://api.telegram.org
QUBITE_BOT_SERVER_URL=http://127.0.0.1:8080   # бот проверяет, жив ли сервер (/api/ready)

# --- Напоминания (PLAN-004): колокольчик, push в браузере, Telegram ---
# Push: `just push-keys` (или `qubite push keys`) печатает строку ключа — вставить сюда и
# перезапустить сервер. Пусто — push выключен (колокольчик и Telegram работают).
# Telegram берёт токен бота выше; кнопки «Понял» / «Через 15 мин» обрабатывает `qubite bot`.
QUBITE_PUSH_VAPID_KEY=
# Контакт для служб push браузеров (mailto: или адрес сайта).
QUBITE_PUSH_SUBJECT=mailto:no-reply@qubiteapp.ru

# --- AI (AI-002; все настройки — `qubite serve --help`) ---
# Без ключа AI выключен. Бюджет по умолчанию — ноль у всех, включая owner:
# лимиты — `qubite ai limit …`, режим «owner без личного лимита» — `qubite ai owner-unlimited on`.
QUBITE_AI_OPENROUTER_API_KEY=
# Комментарии — отдельными строками: systemd (EnvironmentFile) не понимает «# …» после значения.
# Пояс границ дневных и месячных лимитов; таймаут ответа (дальше «неизвестно», резерв держится);
# попыток 1–3 — только если запрос точно не ушёл.
QUBITE_AI_TIMEZONE=Asia/Yekaterinburg
QUBITE_AI_TIMEOUT_SECS=60
QUBITE_AI_MAX_ATTEMPTS=3
# Какие модели разрешить при ПЕРВОМ запуске (через запятую). Пусто — стартовый набор (D-201).
# Дальше модели выбирает owner: `qubite ai catalog`, `qubite ai model <id> on|off`, `qubite ai use <id>`.
QUBITE_AI_OPENROUTER_MODELS=
# data_collection по умолчанию для моделей без своей настройки: allow | deny. Не задано — не отправлять.
# QUBITE_AI_OPENROUTER_DATA_COLLECTION=deny
# Потолки, $. Не задан — не меняется (раскомментировать, чтобы задать). Сброс — в полночь по QUBITE_AI_TIMEZONE.
# Для режима «owner без личного лимита» дневной потолок платформы ОБЯЗАТЕЛЕН (D-212).
# QUBITE_AI_PLATFORM_USD_PER_DAY=1
# QUBITE_AI_PLATFORM_USD_PER_MONTH=10
# На каждого пользователя (у каждого свой счётчик); AI сам по себе не открывает.
# QUBITE_AI_EACH_USER_USD_PER_DAY=0.20
# Защита от зацикливания (0 — выключить проверку): запросов в минуту на человека и на фоновую
# задачу; сколько раз можно отправить один и тот же запрос за окно (секунд).
QUBITE_AI_USER_REQUESTS_PER_MINUTE=20
QUBITE_AI_JOB_REQUESTS_PER_MINUTE=10
QUBITE_AI_REPEAT_LIMIT=3
QUBITE_AI_REPEAT_WINDOW_SECS=600
# ChatGPT по подписке Plus/Pro (Sign in with ChatGPT для open-source, D-216): только для запросов owner.
# Включить: ключ шифрования токенов (`qubite ai secret-key`), вход `qubite ai chatgpt login`, затем true.
QUBITE_AI_CHATGPT_ENABLED=false
QUBITE_AI_SECRET_KEY=
# Голос (ENG-001): распознавание речи (в том числе на ходу, WebSocket) и речь репетитора
# английского через ElevenLabs — тоже через AI-шлюз с бюджетом. Без ключа голос выключен, «Английский» работает текстом.
QUBITE_ELEVENLABS_API_KEY=
# Голос репетитора (ID голоса ElevenLabs; по умолчанию «George»).
# QUBITE_ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# Прокси для внешних запросов сервера (D-515): ElevenLabs (и WebSocket распознавания), OpenRouter,
# ChatGPT, Telegram-бот. Нужен, если сервис закрыт для твоей страны: ElevenLabs из России отвечает
# 302 на свою справку «Do you restrict access…». VPN Hiddify: адрес его порта mixed из настроек,
# обычно http://127.0.0.1:12334. Можно http://, socks5://, socks5h://, логин и пароль — в адресе.
# Пусто — системные HTTPS_PROXY / ALL_PROXY; локальные адреса и NO_PROXY — всегда напрямую.
QUBITE_PROXY=
# Свой прокси сервису поверх общего (по желанию): QUBITE_ELEVENLABS_PROXY, QUBITE_OPENROUTER_PROXY,
# QUBITE_CHATGPT_PROXY, QUBITE_TELEGRAM_PROXY.
# QUBITE_ELEVENLABS_PROXY=
