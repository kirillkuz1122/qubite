# Qubite 2.0 — пример конфигурации.
# Скопируйте в .env (для разработки) или /etc/qubite/qubite.env (сервер, права 600) и заполните.
# Набор переменных — целевой; он уточняется в задачах FND-001, AUTH-*, AI-*, OPS-001.
# Ключ OpenRouter пока задаётся здесь (права файла 600); позже — в Owner Console зашифрованно (ACC-004).

# --- Сервер ---
QUBITE_ENV=dev                         # dev | prod
QUBITE_BIND=127.0.0.1:8080
QUBITE_LOG=info
QUBITE_DATA_DIR=./data                 # файлы (blobs), локальные данные

# --- Домены ---
QUBITE_DOMAIN=qubiteapp.ru             # основной домен; модули — поддомены (auth., plan., docs., …)
QUBITE_PUBLIC_URL=https://qubiteapp.ru
QUBITE_AUTH_URL=https://auth.qubiteapp.ru
QUBITE_TRUST_PROXY=false               # true за Caddy/Cloudflare

# --- База данных ---
DATABASE_URL=postgres://qubite:CHANGE_ME@127.0.0.1:5432/qubite
DATABASE_MAX_CONNECTIONS=10

# --- Шифрование секретов в БД ---
QUBITE_SECRETS_KEY=                    # 32 байта base64; сгенерировать: openssl rand -base64 32

# --- Сессии ---
QUBITE_SESSION_COOKIE_DOMAIN=.qubiteapp.ru
QUBITE_SESSION_TTL_DAYS=30                # срок сессии, продлевается при использовании
QUBITE_COOKIE_SECURE=true                 # cookie только по HTTPS (localhost браузеры тоже пускают)

# --- Аварийные переключатели (сильнее тумблеров Owner Console, ACC-002) ---
# false — выключить; owner всё равно входит по паролю и работает при техработах.
QUBITE_MAINTENANCE=false               # true — техработы для всех, кроме owner
QUBITE_EMAIL_ENABLED=true              # false — письма не отправляются
QUBITE_AUTH_LOGIN_ENABLED=true
QUBITE_AUTH_REGISTRATION_ENABLED=true
QUBITE_AUTH_PASSWORD_ENABLED=true
QUBITE_AUTH_GOOGLE_ENABLED=true
QUBITE_AUTH_YANDEX_ENABLED=true
QUBITE_AUTH_VK_ENABLED=true
QUBITE_AUTH_TELEGRAM_ENABLED=true

# --- Почта (AUTH-002) ---
QUBITE_EMAIL_MODE=mock                 # mock (никуда не отправлять) | resend | smtp
QUBITE_EMAIL_FROM="Qubite <no-reply@qubiteapp.ru>"
QUBITE_EMAIL_REPLY_TO=                 # необязательно, например support@qubiteapp.ru
QUBITE_RESEND_API_KEY=                 # для resend: ключ из resend.com (домен qubiteapp.ru подтверждён там)
QUBITE_SMTP_URL=                       # для smtp: smtps://логин:пароль@smtp.yandex.ru:465 или smtp://…:587?tls=required

# --- Вход через провайдеров (AUTH-004) ---
# Адрес возврата у провайдера: $QUBITE_PUBLIC_URL/api/auth/oauth/<yandex|vk|google>/callback
# Без CLIENT_ID способ входа не показывается. *_ENABLED — стартовое положение (D-194).
QUBITE_OAUTH_YANDEX_CLIENT_ID=
QUBITE_OAUTH_YANDEX_CLIENT_SECRET=
QUBITE_OAUTH_YANDEX_ENABLED=true
QUBITE_OAUTH_VK_CLIENT_ID=
QUBITE_OAUTH_VK_CLIENT_SECRET=
QUBITE_OAUTH_VK_ENABLED=true
QUBITE_OAUTH_GOOGLE_CLIENT_ID=
QUBITE_OAUTH_GOOGLE_CLIENT_SECRET=
QUBITE_OAUTH_GOOGLE_ENABLED=false
QUBITE_TELEGRAM_LOGIN_ENABLED=false       # вход через виджет Telegram (бот — ниже)
QUBITE_TELEGRAM_BOT_NAME=                 # имя нового бота без @

# --- CAPTCHA (AUTH-003): какую показывать — выбирает owner, ключи — здесь ---
QUBITE_CAPTCHA_DISABLED=false          # true — выключить CAPTCHA совсем (сильнее выбора owner)
QUBITE_TURNSTILE_SITE_KEY=
QUBITE_TURNSTILE_SECRET_KEY=
QUBITE_SMARTCAPTCHA_SITE_KEY=          # Yandex SmartCaptcha: ключ клиента
QUBITE_SMARTCAPTCHA_SECRET_KEY=        # Yandex SmartCaptcha: ключ сервера

# --- Telegram-бот (новый, не старый с Pi) ---
QUBITE_TELEGRAM_BOT_TOKEN=                # токен от @BotFather; вставляет владелец

# --- AI (AI-002; все настройки — `qubite serve --help`) ---
# Без ключа AI выключен. Бюджет по умолчанию — ноль у всех, включая owner:
# лимиты — `qubite ai limit …`, режим «owner без личного лимита» — `qubite ai owner-unlimited on`.
QUBITE_AI_OPENROUTER_API_KEY=
QUBITE_AI_TIMEZONE=Asia/Yekaterinburg  # границы дневных и месячных лимитов
QUBITE_AI_TIMEOUT_SECS=60              # дальше результат «неизвестен», резерв держится
QUBITE_AI_MAX_ATTEMPTS=3               # 1–3, только если запрос точно не ушёл
# Разрешённые модели через запятую. Пусто — при первом запуске стартовый набор (D-201),
# дальше решает owner (`qubite ai model <id> on|off`).
QUBITE_AI_OPENROUTER_MODELS=
QUBITE_AI_OPENROUTER_DENY_DATA_COLLECTION=true   # только провайдеры, которые не хранят данные
# Общий потолок расходов платформы, $. Не задан — не меняется (раскомментировать, чтобы задать).
# QUBITE_AI_PLATFORM_USD_PER_DAY=1
# QUBITE_AI_PLATFORM_USD_PER_MONTH=10
