# Core app
HOST=127.0.0.1
PORT=3000
APP_BASE_URL=http://127.0.0.1:3000
NODE_ENV=dev
DATABASE_PATH=/home/kirill/programing/qubite/back/data/qubite.sqlite

# Reverse proxy / same-origin protection
# 0/false  - do not trust proxy headers
# 1/true   - trust loopback/linklocal/uniquelocal reverse proxy
# or a custom Express trust proxy value
TRUST_PROXY=0
ALLOWED_ORIGINS=http://127.0.0.1:3000
ALLOWED_HOSTS=127.0.0.1

# Sessions
SESSION_COOKIE_NAME=qb_session
SESSION_TOUCH_INTERVAL_MS=300000

# Request parsing / connection hardening
JSON_BODY_LIMIT=32kb
HEAVY_JSON_BODY_LIMIT=256kb
IMPORT_JSON_BODY_LIMIT=2mb
REQUEST_TIMEOUT_MS=15000
HEADERS_TIMEOUT_MS=12000
KEEP_ALIVE_TIMEOUT_MS=5000
MAX_REQUESTS_PER_SOCKET=100
SQLITE_BUSY_TIMEOUT_MS=5000
SEED_DEMO_DATA=false

# Cloudflare Turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
# Development only. Do not enable in production.
TURNSTILE_DEV_BYPASS=true

# Email delivery
# log      - dev mode, письма выводятся в консоль сервера
# disabled - письма не отправляются
# resend   - реальные письма через Resend API
EMAIL_DELIVERY_MODE=resend
EMAIL_FROM=Qubite <no-reply@example.com>
EMAIL_REPLY_TO=support@example.com
RESEND_API_KEY=

# ─── OAuth провайдеры ───
# Если CLIENT_ID и CLIENT_SECRET пусты, кнопка провайдера скрывается автоматически.
# CALLBACK_URL должен совпадать с тем, что указан в консоли провайдера.

# Google OAuth
# 1. Перейти: https://console.cloud.google.com/apis/credentials
# 2. «Create Credentials» → «OAuth client ID» → тип «Web application»
# 3. В «Authorized redirect URIs» добавить GOOGLE_CALLBACK_URL
# 4. Скопировать Client ID и Client Secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Аварийный env kill-switch; owner runtime-тумблер есть в админке/Telegram.
OAUTH_GOOGLE_ENABLED=false
GOOGLE_CALLBACK_URL=https://qubiteapp.ru/api/auth/oauth/google/callback

# Yandex OAuth
# 1. Перейти: https://oauth.yandex.ru/client/new
# 2. Создать приложение, выбрать «Веб-сервисы» → «Callback URL» = YANDEX_CALLBACK_URL
# 3. Права: «login:email», «login:info», «login:avatar»
# 4. Скопировать ID и Пароль приложения
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
# Аварийный env kill-switch; owner runtime-тумблер есть в админке/Telegram.
OAUTH_YANDEX_ENABLED=true
YANDEX_CALLBACK_URL=https://qubiteapp.ru/api/auth/oauth/yandex/callback

# VK ID (серверный OAuth с PKCE)
# 1. Перейти: https://id.vk.com/about/business/go → Создать приложение
# 2. Тип: «Веб-сайт», указать адрес и домен
# 3. В настройках → «Базовый домен» → qubiteapp.ru
# 4. «Доверенный Redirect URL» → VK_CALLBACK_URL (ниже)
# 5. Скопировать «ID приложения» и «Защищённый ключ»
VK_APP_ID=
VK_CLIENT_SECRET=
# Аварийный env kill-switch; owner runtime-тумблер есть в админке/Telegram.
OAUTH_VK_ENABLED=true
VK_CALLBACK_URL=https://qubiteapp.ru/api/auth/oauth/vk/callback

# Telegram Bot & Login Widget
# 1. Получить токен: https://t.me/BotFather → /newbot
# 2. Для Login Widget: BotFather → /mybots → Bot Settings → Domain → добавить домен сайта
TELEGRAM_BOT_TOKEN=
# Аварийный env kill-switch; owner runtime-тумблер есть в админке/Telegram.
OAUTH_TELEGRAM_ENABLED=false
# Telegram user ID владельца платформы (только он имеет полный доступ к боту)
TELEGRAM_OWNER_ID=
# Дополнительные модераторы (CSV telegram user IDs). Динамические выдачи — через /grant в боте.
TELEGRAM_MODERATOR_IDS=
# true/false — включить/выключить бота (по умолчанию true, если задан токен)
TELEGRAM_ENABLED=false

# Экосистема: независимый выбор компонентов в deploy/install.sh
INSTALL_PLATFORM=true
INSTALL_VPN=false
INSTALL_SEARCH=true
INSTALL_VAULT=true
# direct: публичный IP и TLS; cloudflare: исходящий Tunnel без белого IP
INGRESS_MODE=cloudflare
MAIN_SITE_DOMAIN=qubiteapp.online
APP_PORT=9130
# Новый туннель: токен берётся в Cloudflare Zero Trust → Networks → Tunnels.
# Для существующего именованного туннеля: конфиг и имя, token не нужен.
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARE_TUNNEL_NAME=
CLOUDFLARE_CONFIG_PATH=
# При совместном использовании машины: Caddyfile для include, не менять её Caddy/VPN.
# Private account invitations; password login retains existing rate limits.
# false: standard registration/login require real Turnstile keys and email delivery.
AUTH_INVITE_ONLY=true
SESSION_COOKIE_DOMAIN=.qubiteapp.online
SERVICES_SEARCH_BASE_URL=https://search.qubiteapp.online
SERVICES_VAULT_BASE_URL=https://vault.qubiteapp.online
# Generate: openssl rand -hex 32. Internal endpoints require this secret.
SERVICES_INTERNAL_KEY=
VAULT_ORIGIN_CA=
VAULT_ORIGIN_PORT=9082
VAULT_MANAGEMENT_SOCKET=/run/qubite-vault/manage.sock
ALIASVAULT_IMAGE=ghcr.io/aliasvault/aliasvault:0.30.7
ALIASVAULT_PORT=9082
SEARCH_PORT=9120
SEARXNG_PORT=9081
SEARCH_OPENROUTER_API_KEY=
SEARCH_DAILY_BUDGET_USD=0.05
SEARCH_JEV_MODEL=typesafe/jev-1.13
SEARCH_FREE_MODEL=google/gemma-4-26b-a4b-it:free
SEARCH_FREE_PROVIDERS=google-ai-studio
SEARCH_FREE_INPUT=0
SEARCH_FREE_OUTPUT=0
SEARCH_FREE_MAX_TOKENS=3200
SEARCH_ECONOMY_MODEL=mistralai/mistral-nemo
SEARCH_ECONOMY_PROVIDERS=deepinfra/fp8
SEARCH_ECONOMY_INPUT=0.019
SEARCH_ECONOMY_OUTPUT=0.03
SEARCH_ECONOMY_MAX_TOKENS=2400
SEARCH_BALANCED_MODEL=inclusionai/ling-3.0-flash
SEARCH_BALANCED_PROVIDERS=novita
SEARCH_BALANCED_INPUT=0.021
SEARCH_BALANCED_OUTPUT=0.063
SEARCH_BALANCED_MAX_TOKENS=3000
SEARCH_DEEP_MODEL=anthropic/claude-haiku-5.5
SEARCH_DEEP_PROVIDERS=anthropic,google-vertex/global
SEARCH_DEEP_INPUT=0.10
SEARCH_DEEP_OUTPUT=0.50
SEARCH_DEEP_MAX_TOKENS=5000
# Цены выше — потолки за миллион токенов, предотвращают дорогой fallback.
# Бесплатный резерв по умолчанию Ling 3.1/Novita разрешён только при цене 0.
SEARCH_FREE_FALLBACK_MODEL=inclusionai/ling-3.1-flash
SEARCH_FREE_FALLBACK_PROVIDERS=novita

# false: VPN-кнопки отключены до настройки входящего доступа к ноде.
SERVICES_VPN_ENABLED=false
# Optional: existing pinned origin certificate/container installation.
VAULT_EXISTING_CERT=
# Existing Caddy root config; managed fragment is imported after validation.
SERVICES_CADDY_INCLUDE=/etc/caddy/Caddyfile
# Empty: use sudo caller, otherwise create qubite system user.
SERVICES_USER=

# Loopback search endpoint for owner-only Telegram spending statistics.
SEARCH_INTERNAL_URL=http://127.0.0.1:9120

# Быстрый краткий ответ / API, актуальная скидка Novita; цены в $/M токенов
SEARCH_FAST_MODEL=inclusionai/ling-3.0-flash
SEARCH_FAST_PROVIDERS=novita
SEARCH_FAST_INPUT=0.021
SEARCH_FAST_OUTPUT=0.063
SEARCH_FAST_MAX_TOKENS=2600

# Qubite Writing: optional local LanguageTool + separate AI budget
INSTALL_WRITING=false
LANGUAGETOOL_URL=http://127.0.0.1:9091
LANGUAGETOOL_PORT=9091
WRITING_OPENROUTER_API_KEY=
WRITING_KEY_FILE=
WRITING_DAILY_BUDGET_RUB=5
# Explicit accounting conversion; update when exchange rate changes
WRITING_RUB_PER_USD=100
WRITING_RATE_DATE=manual

# Auth and the owner control bot stay running when the site is switched off.
AUTH_PORT=9131
RUNTIME_MANAGEMENT_SOCKET=/run/qubite-runtime/manage.sock
SERVICES_MEMOS_BASE_URL=https://memos.qubiteapp.online
SERVICES_VIKUNJA_BASE_URL=https://vikunja.qubiteapp.online
# Set by split systemd units; leave blank for the legacy single-process mode.
QUBITE_PROCESS_ROLE=

# Optional private Unix-socket directory for split-process support events
QUBITE_EVENT_SOCKET_DIR=
