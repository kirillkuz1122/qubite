# Qubite 2.0: шаблон только действующей конфигурации core (0.6.0).
# Core читает переменные процесса, не загружает .env автоматически.
# Передавать значения через явную конфигурацию окружения; не source произвольный файл.
# Заполненный старый deploy/.env не является конфигурацией нового core.
# Dedicated PostgreSQL; реальные URL/пароли здесь не сохранять.
QUBITE_CORE_DATABASE_URL=
QUBITE_CORE_DB_TIMEOUT_SECONDS=2
# Точный HTTPS origin без пути. Для локального HTTP см. core/README.md.
QUBITE_CORE_AUTH_ORIGIN=
QUBITE_CORE_AUTH_LOCAL_HTTP=false
# Провайдеры и почта выключены; SMTP ещё не реализован.
QUBITE_CORE_OAUTH_NETWORK_ENABLED=false
QUBITE_CORE_EMAIL_CHALLENGES_ENABLED=false
QUBITE_CORE_OAUTH_GOOGLE_CLIENT_ID=
QUBITE_CORE_OAUTH_GOOGLE_CLIENT_SECRET=
QUBITE_CORE_OAUTH_YANDEX_CLIENT_ID=
QUBITE_CORE_OAUTH_YANDEX_CLIENT_SECRET=
QUBITE_CORE_OAUTH_VK_CLIENT_ID=
QUBITE_CORE_OAUTH_VK_CLIENT_SECRET=
QUBITE_CORE_OAUTH_TELEGRAM_CLIENT_ID=
QUBITE_CORE_OAUTH_TELEGRAM_CLIENT_SECRET=
# Owner создаётся локально CLI: email + подтверждение; пароль через getpass.
# Нет OWNER_PASSWORD, автоматического owner, платных ключей или module grants.
